<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - MyShop</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #eaf2ff, #f7faff);
      padding: 20px;
    }

    .auth-container {
      width: 100%;
      max-width: 420px;
    }

    .brand {
      text-align: center;
      margin-bottom: 25px;
    }

    .brand h1 {
      color: #2563eb;
      font-size: 34px;
      margin-bottom: 6px;
    }

    .brand p {
      color: #64748b;
      font-size: 14px;
    }

    .card {
      background: #ffffff;
      border-radius: 18px;
      padding: 35px;
      box-shadow: 0 15px 40px rgba(15, 23, 42, 0.10);
      border: 1px solid #e2e8f0;
    }

    .card h2 {
      text-align: center;
      color: #1e293b;
      margin-bottom: 8px;
      font-size: 26px;
    }

    .subtitle {
      text-align: center;
      color: #64748b;
      font-size: 14px;
      margin-bottom: 28px;
    }

    .form-group {
      margin-bottom: 18px;
    }

    .form-group label {
      display: block;
      margin-bottom: 7px;
      color: #334155;
      font-size: 14px;
      font-weight: 600;
    }

    .form-group input {
      width: 100%;
      padding: 13px 14px;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      font-size: 15px;
      outline: none;
      transition: 0.2s;
    }

    .form-group input:focus {
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10);
    }

    .btn {
      width: 100%;
      padding: 13px;
      border: none;
      border-radius: 10px;
      background: #2563eb;
      color: white;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: 0.2s;
      margin-top: 5px;
    }

    .btn:hover {
      background: #1d4ed8;
      transform: translateY(-1px);
    }

    .extra-links {
      text-align: center;
      margin-top: 20px;
      font-size: 14px;
      color: #64748b;
    }

    .extra-links a {
      color: #2563eb;
      text-decoration: none;
      font-weight: 600;
    }

    .extra-links a:hover {
      text-decoration: underline;
    }

    .home-btn {
      width: 100%;
      margin-top: 15px;
      padding: 12px;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      background: #ffffff;
      color: #334155;
      font-size: 14px;
      cursor: pointer;
      transition: 0.2s;
    }

    .home-btn:hover {
      background: #f8fafc;
    }

    @media (max-width: 480px) {
      .card {
        padding: 25px 20px;
      }

      .brand h1 {
        font-size: 30px;
      }
    }
  </style>
</head>

<body>

  <div class="auth-container">

    <div class="brand">
      <h1>MyShop</h1>
      <p>Simple shopping. Easy selling.</p>
    </div>

    <div class="card">
      <h2>Welcome Back</h2>
      <p class="subtitle">Login to continue to your account</p>

      <form action="/loginForm" method="POST">

        <div class="form-group">
          <label for="username">Username</label>
          <input
            type="text"
            id="username"
            name="username"
            placeholder="Enter your username"
            required
          >
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="Enter your password"
            required
          >
        </div>

        <button type="submit" class="btn">
          Login
        </button>

      </form>

      <div class="extra-links">
        Don't have an account?
        <a href="/register">Create one</a>
      </div>

      <button
        class="home-btn"
        onclick="window.location.href='/'"
      >
        ← Back to Home
      </button>

    </div>

  </div>

</body>
</html>