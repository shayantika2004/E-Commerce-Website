<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Checkout - MyShop</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #f8fafc;
            color: #0f172a;
            min-height: 100vh;
        }

        /* =========================
           HEADER
           ========================= */

        .header {
            position: sticky;
            top: 0;
            z-index: 1000;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 16px 5%;

            background: rgba(255, 255, 255, 0.96);
            border-bottom: 1px solid #e2e8f0;

            backdrop-filter: blur(10px);
        }

        .brand {
            color: #2563eb;
            font-size: 1.6rem;
            font-weight: 800;
        }

        .header-btn {
            padding: 9px 15px;

            border: 1px solid #cbd5e1;
            border-radius: 8px;

            background: white;
            color: #475569;

            font-size: 0.95rem;
            font-weight: 600;

            cursor: pointer;
            transition: 0.2s ease;
        }

        .header-btn:hover {
            background: #eff6ff;
            border-color: #2563eb;
            color: #2563eb;
        }

        /* =========================
           PAGE
           ========================= */

        .page {
            max-width: 1100px;
            margin: 0 auto;
            padding: 45px 5% 70px;
        }

        .page-header {
            margin-bottom: 30px;
        }

        .page-header h1 {
            color: #0f172a;
            font-size: clamp(2rem, 4vw, 2.7rem);
            margin-bottom: 7px;
        }

        .page-header p {
            color: #64748b;
            line-height: 1.6;
        }

        /* =========================
           CHECKOUT LAYOUT
           ========================= */

        .checkout-layout {
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 25px;
            align-items: start;
        }

        .section {
            background: white;

            border: 1px solid #e2e8f0;
            border-radius: 16px;

            padding: 25px;

            box-shadow:
                0 8px 25px rgba(15, 23, 42, 0.05);
        }

        .section h2 {
            color: #0f172a;
            font-size: 1.25rem;

            padding-bottom: 15px;
            margin-bottom: 20px;

            border-bottom: 1px solid #e2e8f0;
        }

        /* =========================
           ADDRESS FORM
           ========================= */

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-label {
            color: #334155;
            font-size: 0.9rem;
            font-weight: 700;
        }

        .address-input {
            width: 100%;
            min-height: 150px;

            padding: 13px 14px;

            border: 1px solid #cbd5e1;
            border-radius: 9px;

            color: #0f172a;
            background: white;

            font-size: 0.95rem;
            line-height: 1.6;

            resize: vertical;
            outline: none;

            transition:
                border-color 0.2s ease,
                box-shadow 0.2s ease;
        }

        .address-input:focus {
            border-color: #2563eb;

            box-shadow:
                0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        .address-help {
            margin-top: 8px;

            color: #94a3b8;
            font-size: 0.82rem;
        }

        /* =========================
           ORDER SUMMARY
           ========================= */

        .summary {
            position: sticky;
            top: 95px;
        }

        .order-item {
            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 15px;

            padding: 14px 0;

            border-bottom: 1px solid #e2e8f0;
        }

        .order-item:last-child {
            border-bottom: none;
        }

        .item-info {
            min-width: 0;
        }

        .item-name {
            margin-bottom: 5px;

            color: #334155;
            font-size: 0.95rem;
            font-weight: 700;
        }

        .item-quantity {
            color: #64748b;
            font-size: 0.85rem;
        }

        .item-price {
            flex-shrink: 0;

            color: #0f172a;
            font-weight: 700;
        }

        .total {
            display: flex;
            justify-content: space-between;

            margin-top: 20px;
            padding-top: 18px;

            border-top: 1px solid #cbd5e1;
        }

        .total-label {
            color: #334155;
            font-size: 1.05rem;
            font-weight: 700;
        }

        .total-price {
            color: #2563eb;
            font-size: 1.25rem;
            font-weight: 800;
        }

        /* =========================
           ACTIONS
           ========================= */

        .place-order {
            width: 100%;

            margin-top: 22px;
            padding: 14px 18px;

            border: none;
            border-radius: 9px;

            background: #2563eb;
            color: white;

            font-size: 1rem;
            font-weight: 700;

            cursor: pointer;

            transition: 0.2s ease;
        }

        .place-order:hover {
            background: #1d4ed8;
            transform: translateY(-1px);
        }

        .back-btn {
            display: block;
            width: 100%;

            margin-top: 10px;
            padding: 12px 18px;

            border: 1px solid #cbd5e1;
            border-radius: 9px;

            background: white;
            color: #475569;

            font-size: 0.9rem;
            font-weight: 700;

            text-align: center;

            cursor: pointer;
            transition: 0.2s ease;
        }

        .back-btn:hover {
            background: #f8fafc;
            border-color: #94a3b8;
        }

        /* =========================
           FOOTER
           ========================= */

        .footer {
            padding: 25px 20px;

            background: #0f172a;
            color: #94a3b8;

            text-align: center;
            font-size: 0.9rem;
        }

        /* =========================
           RESPONSIVE
           ========================= */

        @media (max-width: 850px) {

            .checkout-layout {
                grid-template-columns: 1fr;
            }

            .summary {
                position: static;
            }
        }

        @media (max-width: 600px) {

            .header {
                padding: 14px 4%;
            }

            .brand {
                font-size: 1.35rem;
            }

            .page {
                padding: 30px 4% 50px;
            }

            .section {
                padding: 20px;
            }
        }
    </style>
</head>

<body>

    <!-- =========================
         HEADER
         ========================= -->

    <header class="header">

        <div class="brand">
            MyShop
        </div>

        <form action="/cart" method="GET">
            <button type="submit" class="header-btn">
                ← Back to Cart
            </button>
        </form>

    </header>


    <!-- =========================
         MAIN
         ========================= -->

    <main class="page">

        <div class="page-header">

            <h1>Checkout</h1>

            <p>
                Enter your delivery details and review your order before placing it.
            </p>

        </div>


        <form action="/place-order" method="POST">

            <div class="checkout-layout">

                <!-- =========================
                     DELIVERY DETAILS
                     ========================= -->

                <section class="section">

                    <h2>Delivery Details</h2>

                    <div class="form-group">

                        <label
                            class="form-label"
                            for="address">

                            Delivery Address

                        </label>

                        <textarea
                            id="address"
                            name="address"
                            class="address-input"
                            placeholder="Enter your complete delivery address"
                            required></textarea>

                        <p class="address-help">
                            Please include your house/building number,
                            street, city, state, and PIN code.
                        </p>

                    </div>

                </section>


                <!-- =========================
                     ORDER SUMMARY
                     ========================= -->

                <aside class="section summary">

                    <h2>Order Summary</h2>

                    <% cart.items.forEach(item => { %>

                        <div class="order-item">

                            <div class="item-info">

                                <div class="item-name">
                                    <%= item.product.name %>
                                </div>

                                <div class="item-quantity">
                                    Quantity: <%= item.quantity %>
                                </div>

                            </div>

                            <div class="item-price">
                                $<%= item.product.price * item.quantity %>
                            </div>

                        </div>

                    <% }) %>


                    <div class="total">

                        <span class="total-label">
                            Total
                        </span>

                        <span class="total-price">
                            $<%= grandTotal %>
                        </span>

                    </div>


                    <button
                        type="submit"
                        class="place-order">

                        Place Order

                    </button>


                    <a
                        href="/cart"
                        class="back-btn">

                        ← Return to Cart

                    </a>

                </aside>

            </div>

        </form>

    </main>


    <!-- =========================
         FOOTER
         ========================= -->

    <footer class="footer">

        <p>
            © 2025 MyShop. All rights reserved.
        </p>

    </footer>

</body>
</html>