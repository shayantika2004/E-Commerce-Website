<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Products - MyShop</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #f8fafc;
            color: #0f172a;
            min-height: 100vh;
        }

        /* =========================
           HEADER
           ========================= */

        .header {
            position: sticky;
            top: 0;
            z-index: 1000;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 16px 5%;

            background: rgba(255, 255, 255, 0.96);
            border-bottom: 1px solid #e2e8f0;

            backdrop-filter: blur(10px);
        }

        .brand {
            color: #2563eb;
            font-size: 1.6rem;
            font-weight: 800;
        }

        .back-btn {
            padding: 9px 16px;

            border: 1px solid #cbd5e1;
            border-radius: 8px;

            background: white;
            color: #475569;

            font-size: 0.95rem;
            font-weight: 600;

            cursor: pointer;
            transition: 0.2s ease;
        }

        .back-btn:hover {
            border-color: #2563eb;
            color: #2563eb;
            background: #eff6ff;
        }

        /* =========================
           PAGE HEADER
           ========================= */

        .page-header {
            max-width: 1200px;
            margin: 45px auto 30px;
            padding: 0 5%;
        }

        .page-header h1 {
            font-size: clamp(2rem, 4vw, 2.7rem);
            color: #0f172a;
            margin-bottom: 8px;
        }

        .page-header p {
            color: #64748b;
            line-height: 1.6;
        }

        /* =========================
           PRODUCTS
           ========================= */

        .products-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 5% 60px;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(
                auto-fit,
                minmax(220px, 1fr)
            );
            gap: 24px;
        }

        .product-card {
            background: white;

            border: 1px solid #e2e8f0;
            border-radius: 16px;

            overflow: hidden;

            box-shadow: 0 6px 20px rgba(15, 23, 42, 0.05);

            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(15, 23, 42, 0.1);
        }

        .product-image-link {
            display: block;
            text-decoration: none;
        }

        .product-image {
            display: block;

            width: 100%;
            height: 230px;

            object-fit: cover;

            background: #f1f5f9;
        }

        .product-content {
            padding: 18px;
        }

        .product-name {
            margin-bottom: 7px;

            color: #0f172a;
            font-size: 1.05rem;
            font-weight: 700;
        }

        .product-price {
            margin-bottom: 17px;

            color: #2563eb;
            font-size: 1.15rem;
            font-weight: 800;
        }

        .add-cart-btn {
            width: 100%;

            padding: 11px 14px;

            border: none;
            border-radius: 9px;

            background: #2563eb;
            color: white;

            font-size: 0.95rem;
            font-weight: 700;

            cursor: pointer;
            transition: 0.2s ease;
        }

        .add-cart-btn:hover {
            background: #1d4ed8;
            transform: translateY(-1px);
        }

        /* =========================
           EMPTY STATE
           ========================= */

        .empty-state {
            padding: 60px 20px;

            text-align: center;

            background: white;

            border: 1px dashed #cbd5e1;
            border-radius: 16px;

            color: #64748b;
        }

        .empty-state h2 {
            margin-bottom: 8px;
            color: #334155;
        }

        /* =========================
           FOOTER
           ========================= */

        .footer {
            padding: 25px 20px;

            background: #0f172a;
            color: #94a3b8;

            text-align: center;

            font-size: 0.9rem;
        }

        /* =========================
           RESPONSIVE
           ========================= */

        @media (max-width: 600px) {

            .header {
                padding: 14px 4%;
            }

            .brand {
                font-size: 1.35rem;
            }

            .page-header {
                margin-top: 30px;
                padding: 0 4%;
            }

            .products-container {
                padding: 0 4% 45px;
            }

            .product-image {
                height: 200px;
            }
        }
    </style>
</head>

<body>

    <!-- =========================
         HEADER
         ========================= -->

    <header class="header">

        <div class="brand">
            MyShop
        </div>

        <form action="/profile" method="GET">
            <button type="submit" class="back-btn">
                ← Back to Home
            </button>
        </form>

    </header>


    <!-- =========================
         PAGE HEADING
         ========================= -->

    <section class="page-header">

        <h1>All Products</h1>

        <p>
            Explore products available in the MyShop marketplace.
            Select a product to view its details or add it to your cart.
        </p>

    </section>


    <!-- =========================
         PRODUCT GRID
         ========================= -->

    <main class="products-container">

        <% if (products && products.length > 0) { %>

            <div class="product-grid">

                <% products.forEach(product => { %>

                    <article class="product-card">

                        <!-- Product image/name opens details -->
                        <a
                            href="/product/<%= product._id %>"
                            class="product-image-link">

                            <img
                                class="product-image"
                                src="/uploads/<%= product.image %>"
                                alt="<%= product.name %>"
                            >

                        </a>

                        <div class="product-content">

                            <h2 class="product-name">
                                <%= product.name %>
                            </h2>

                            <div class="product-price">
                                $<%= product.price %>
                            </div>

                            <form
                                action="/add-to-cart/<%= product._id %>"
                                method="POST">

                                <button
                                    type="submit"
                                    class="add-cart-btn">

                                    🛒 Add to Cart

                                </button>

                            </form>

                        </div>

                    </article>

                <% }) %>

            </div>

        <% } else { %>

            <div class="empty-state">

                <h2>No products available</h2>

                <p>
                    Products will appear here once sellers add them.
                </p>

            </div>

        <% } %>

    </main>


    <!-- =========================
         FOOTER
         ========================= -->

    <footer class="footer">

        <p>
            © 2025 MyShop. All rights reserved.
        </p>

    </footer>

</body>
</html>